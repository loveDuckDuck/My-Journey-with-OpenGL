{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: g++ build active file with glad and Shader from fixed folder",
      "command": "/usr/bin/g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        // Source files
        "${file}",
        "${workspaceFolder}/Utilities/glad.c",
        "${workspaceFolder}/Utilities/ShaderClass/Shader.cpp",
        "${workspaceFolder}/Utilities/ShaderClass/TextureLoader.cpp",
        "${workspaceFolder}/Utilities/CameraClass/Camera.cpp",
        "${workspaceFolder}/Utilities/ModelClass/Model.cpp",
        "${workspaceFolder}/Utilities/ModelClass/Mesh.cpp",
        // Output
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        // Include paths
        "-I${workspaceFolder}/Utilities",
        "-I${workspaceFolder}/Utilities/Shader",
        "-I${workspaceFolder}/Utilities/ShaderClass",
        "-I${workspaceFolder}/Utilities/Camera",
        "-I${workspaceFolder}/Utilities/ModelClass",
        "-I/usr/include/assimp",
        "-I./minimp3",
        // Libraries
        "-ldl",
        "-lglfw",
        "-lassimp",
        "-lopenal",
        "-lsndfile"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compile active file plus glad and Shader from fixed Utilities folder"
    }
  ]
}